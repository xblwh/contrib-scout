# Export these in your shell. This file is documentation; it is not loaded automatically.
# Without a token, public GitHub API requests still work with a lower rate limit.
GITHUB_TOKEN=
# Alternatively install and log into gh, then pass --use-gh.
# AI is opt-in: set all three, then use --ai or the browser checkbox.
SCOUT_LLM_BASE_URL=https://api.openai.com/v1
SCOUT_LLM_MODEL=
SCOUT_LLM_API_KEY=
# Optional pricing in USD per million tokens. No built-in price assumptions.
SCOUT_INPUT_PRICE_PER_MILLION=
SCOUT_OUTPUT_PRICE_PER_MILLION=
